# 빌드 산출물
web/node_modules/
web/.next/
web/out/
web/.test-dist/
web/tsconfig.tsbuildinfo
server/.gradle/
server/build/
server/**/build/
**/bin/

# 환경/비밀
.env
.evn
.env.*
!.env.example
!.env.*.example
*.local

# IDE
.idea/
.vscode/
*.iml

# OS
Thumbs.db
Desktop.ini
.DS_Store

# 로그/임시
*.log
*.err
*.tmp
tmp/
# 로컬 데모 런타임 산출물. 기동 스크립트가 남기는 프로세스 id라 커밋 대상이 아니다
*.pid
# harness/evidence/ 아래는 검증 원본이 사는 자리다. 위 로그 규칙이 증거를 무음으로 삼키면
# 문서가 인용한 원자료가 저장소에 없는 상태가 된다. 상위 디렉터리는 무시되지 않아 예외가 성립한다
!harness/evidence/**/*.log
!harness/evidence/**/*.err
!증거본/**/*.log

# 테스트·세션 런타임 산물 (재생성됨, 추적 불필요)
**/.jqwik-database
.claude/scheduled_tasks.lock
# 도구 권한 등 기기별 로컬 설정. 역할 하네스(.claude/agents)·launch.json은 계속 추적한다
.claude/settings.local.json

# 문서 빌드 중간물은 추적하되, PDF 소스 HTML은 유지한다.
# (docs/**/*.html은 PDF 재생성 원본이므로 커밋 대상)

# AI 인수인계서. 산출물 아닌 작업용 로컬 메모라 추적하지 않는다.
/AI_인수인계서.md

# k6 실행 산출물. 매 실행마다 바뀌고 크기도 커서 추적하지 않는다.
harness/load/artifacts/
# 부하 계정 키. 발급 시점 평문 시크릿이라 저장소에 두지 않는다(README 규약).
harness/load/secrets/k6_keys.json
# Patroni 실험 기록기의 기본 출력 폴더. 실행기는 PATRONI_EP_OUT 으로 저장소 밖을 준다.
harness/patroni/ep-out/

# drawio 편집 중 잠금·백업 파일. 앱이 열어둔 동안만 생기고 닫으면 사라진다
.$*.drawio.bkp
.$*.drawio.dtmp

# Office 잠금·임시 파일. 문서를 열어 둔 채로 커밋하면 딸려 들어간다.
# 실제로 제출_20260901/~$기획안.docx 가 162 바이트로 추적되고 있었다(2026-09-08 제거).
~$*
__pycache__/

# k6 원문 로그. 회차마다 수 MB 이고 진단용이다. 판정은 clean-*.json 이 갖는다.
harness/evidence/k6-*.log

# VM 실습망(deploy/vm-lab)의 내려받은 배포물은 추적하지 않는다.
# 설치 ISO 약 3.3GB, 앱 JAR 과 exporter 배포본 약 118MB 다. 저장소에 둘 크기가 아니고
# 상류에서 다시 받을 수 있다. 받는 주소와 SHA-256 은 build/scripts 의 절차가 갖고 있다.
deploy/vm-lab/stage/
deploy/vm-lab/iso/
*.viso
# 작업 중 생기는 SSH 호스트키 캐시. 증거가 아니다.
deploy/vm-lab/캡처/**/known_hosts
# 관리 키 자리. 공개키만 추적한다. 2026-09-21 에 이 폴더에 개인키가 평문으로 들어가
# 여섯 대의 root 권한과 같아진 적이 있다(deploy/vm-lab/build/01-검증지적.txt).
# 개인키는 사용자 프로필의 ~/.ssh 아래에 두고 여기에는 .pub 만 놓는다.
deploy/vm-lab/build/keys/*
!deploy/vm-lab/build/keys/*.pub

# S7 관문 실행기의 웹 빌드 출력. Next 빌드 로그의 기호가 문체 검사에 걸리고 실험 판정 자료가 아니다(빌드 결과 코드는 gate.json의 buildRc).
harness/evidence/**/web_build.log

# 시연 영상 작업 폴더는 원본 녹화·편집 중간 파일이 1GB를 넘어 PC에만 둔다. 저장소에는 v4 7분 자막판(음악 있음·없음) 두 개만 올린다(2026-10-10 사용자 결정).
/영상/**
!/영상/**/
!/영상/03_클로드_AWS시연/3_완성본/페일스톱_AWS시연_v4_자막.mp4
!/영상/03_클로드_AWS시연/3_완성본/페일스톱_AWS시연_v4_자막_브금없음.mp4
