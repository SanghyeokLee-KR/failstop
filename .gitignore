# 빌드 산출물
web/node_modules/
web/.next/
web/out/
web/.test-dist/
web/tsconfig.tsbuildinfo
server/.gradle/
server/build/
server/**/build/
**/bin/

# 환경/비밀
.env
.env.*
!.env.example
!.env.*.example
*.local

# IDE
.idea/
.vscode/
*.iml

# OS
Thumbs.db
Desktop.ini
.DS_Store

# 로그/임시
*.log
*.tmp
tmp/
# 로컬 데모 런타임 산출물. 기동 스크립트가 남기는 프로세스 id라 커밋 대상이 아니다
*.pid

# 테스트·세션 런타임 산물 (재생성됨, 추적 불필요)
**/.jqwik-database
.claude/scheduled_tasks.lock
# 도구 권한 등 기기별 로컬 설정. 역할 하네스(.claude/agents)·launch.json은 계속 추적한다
.claude/settings.local.json

# 문서 빌드 중간물은 추적하되, PDF 소스 HTML은 유지한다.
# (docs/**/*.html은 PDF 재생성 원본이므로 커밋 대상)

# AI 인수인계서. 산출물 아닌 작업용 로컬 메모라 추적하지 않는다.
/AI_인수인계서.md

# k6 실행 산출물. 매 실행마다 바뀌고 크기도 커서 추적하지 않는다.
harness/load/artifacts/
# 부하 계정 키. 발급 시점 평문 시크릿이라 저장소에 두지 않는다(README 규약).
harness/load/secrets/k6_keys.json

# drawio 편집 중 잠금·백업 파일. 앱이 열어둔 동안만 생기고 닫으면 사라진다
.$*.drawio.bkp
.$*.drawio.dtmp
