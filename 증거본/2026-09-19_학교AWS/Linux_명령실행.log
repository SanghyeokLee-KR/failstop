2026-09-19T12:58:17.147Z
import json,urllib.request,urllib.parse,collections
base='http://127.0.0.1:9090/api/v1/'
def read(url):
 return json.load(urllib.request.urlopen(url,timeout=10))
counts=collections.defaultdict(lambda:[0,0,0])
for q in json.load(open('/tmp/msp-6ee1179/queries.json')):
 expr=q['expr']
 for k,v in {'$customer':'exchange','$environment':'aws','$__rate_interval':'1m','$__range':'30m','$__interval':'15s'}.items():expr=expr.replace(k,v)
 c=counts[q['dashboard']];c[0]+=1
 try:
  data=read(base+'query?'+urllib.parse.urlencode({'query':expr}))
  if data['status']!='success':raise ValueError(data.get('error'))
  if data['data']['result']:c[1]+=1
 except Exception as e:c[2]+=1;print('ERROR',q['dashboard'],q['panel'],str(e))
for name,c in counts.items():print(name,'queries/data/errors',*c)
for t in read(base+'targets')['data']['activeTargets']:print(t['labels'],t['health'],t['lastError'])
for expr in ['exchange_node_serviceable','exchange_leader_is_leader','http_server_requests_seconds_count','process_cpu_usage']:
 data=read(base+'query?'+urllib.parse.urlencode({'query':expr+'{job="exchange-api",environment="aws"}'}))
 print('metric',expr,'series',len(data['data']['result']))

