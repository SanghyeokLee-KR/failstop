import configparser,glob,sqlite3
c=configparser.ConfigParser(interpolation=None); c.read('/etc/grafana/grafana.ini')
print('anonymous_enabled:',c.get('auth.anonymous','enabled',fallback='false'))
print('disable_initial_admin_creation:',c.get('security','disable_initial_admin_creation'))
print('bootstrap_files_remaining:',len(glob.glob('/etc/grafana/bootstrap-*')))
db=sqlite3.connect('file:/var/lib/grafana/grafana.db?mode=ro',uri=True)
print('users:',db.execute('SELECT login,is_admin FROM user').fetchall())

printf '%s' '' | base64 -d | sudo python3; systemctl is-active grafana-server; curl -fsS http://127.0.0.1:3000/api/health; curl -sS -o /dev/null -w '\nAnonymous API HTTP %{http_code}\n' http://127.0.0.1:3000/api/search
