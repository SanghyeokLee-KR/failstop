					100 text # We should start postgresql service after network is up (rhbz#2127534 and rhbz#2157651)
					101 text After=network-online.target
					102 text [Service]
					103 text Type=notify
					104 text User=postgres
					105 text Group=postgres
					106 text # Where to send early-startup messages from the server (before the logging
					107 text # options of postgresql.conf take effect)
					108 text # This is normally controlled by the global default set by systemd
					109 text # StandardOutput=syslog
					110 text # Disable OOM kill on the postgres
					111 text OOMScoreAdjust=-1000
					112 text # ... but allow it still to be effective for child processes
					113 text # (note that these settings are ignored by Postgres releases before 9.5)
					114 text Environment=PG_OOM_ADJUST_FILE=/proc/self/oom_score_adj
					115 text Environment=PG_OOM_ADJUST_VALUE=0
					116 text Environment=PGDATA=/var/lib/pgsql/data
					117 text ExecStartPre=/usr/libexec/postgresql-check-db-dir %N
					118 text # Even though the $PGDATA variable is exported (postgres would accept that)
					119 text # use the -D option here so PGDATA content is printed by /bin/ps and by
					120 text # 'systemctl status'.
					121 text ExecStart=/usr/bin/postgres -D ${PGDATA}
					122 text ExecReload=/bin/kill -HUP $MAINPID
					123 text KillMode=mixed
					124 text KillSignal=SIGINT
					125 text # No artificial start/stop timeout (rhbz#1525477, pgrpms#2786).
					126 text TimeoutSec=0
					127 text [Install]
					128 text WantedBy=multi-user.target
					129 text total 0
					130 text drwx------. 2 postgres postgres  6 Aug 19 00:28 .
