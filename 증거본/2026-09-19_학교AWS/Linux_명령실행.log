import json,urllib.request,urllib.parse
base='http://127.0.0.1:9090/api/v1/'
def query(q):return json.load(urllib.request.urlopen(base+'query?'+urllib.parse.urlencode({'query':q}),timeout=10))['data']['result']
for t in json.load(urllib.request.urlopen(base+'targets'))['data']['activeTargets']:print('TARGET',t['labels'].get('node'),t['labels']['job'],t['health'],t['lastError'])
for q in ['pg_up','pg_exporter_last_scrape_error','pg_wal_position_in_recovery','pg_replication_client_sent_replay_bytes','pg_ops_sql_collection_available','node_scrape_collector_success == 0','node_filesystem_size_bytes{mountpoint="/",environment="aws"}','node_filesystem_avail_bytes{mountpoint="/",environment="aws"}']:
 print(q,[(r['metric'].get('node'),r['value'][1]) for r in query(q)])

