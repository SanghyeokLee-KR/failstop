2026-09-19T10:13:21.346Z host=i-099799f0dc164ae71 command=sudo install -d -o root -g postgres -m 0750 /etc/postgresql && printf '%s' '# 학교 EC2의 PostgreSQL 17 공통 설정. 노드 주소와 인증서는 node.conf에서 지정한다.
port = 5432
max_connections = 100
shared_buffers = '"'"'256MB'"'"'
effective_cache_size = '"'"'1GB'"'"'
work_mem = '"'"'4MB'"'"'
maintenance_work_mem = '"'"'64MB'"'"'
autovacuum_work_mem = '"'"'64MB'"'"'
password_encryption = '"'"'scram-sha-256'"'"'

# 비동기 복제라도 Primary의 로컬 WAL 기록은 기다린다.
wal_level = replica
synchronous_commit = on
synchronous_standby_names = '"'"''"'"'
max_wal_senders = 4
max_replication_slots = 4
max_slot_wal_keep_size = '"'"'4GB'"'"'
wal_log_hints = on
wal_keep_size = 0
archive_mode = off
hot_standby = on
idle_in_transaction_session_timeout = '"'"'10s'"'"'
tcp_keepalives_idle = 5
tcp_keepalives_interval = 2
tcp_keepalives_count = 3

# systemd journal에서 서비스 로그를 관리한다. SQL 본문은 상시 기록하지 않는다.
logging_collector = off
log_destination = '"'"'stderr'"'"'
log_line_prefix = '"'"'%m [%p] %q%u@%d '"'"'
log_statement = '"'"'none'"'"'
log_min_error_statement = '"'"'panic'"'"'
log_lock_waits = on
log_checkpoints = on
ssl = on
ssl_min_protocol_version = '"'"'TLSv1.2'"'"'
ssl_cert_file = '"'"'/etc/postgresql/server.crt'"'"'
ssl_key_file = '"'"'/etc/postgresql/server.key'"'"'
include = '"'"'/etc/postgresql/node.conf'"'"'
' | sudo tee /etc/postgresql/exchange.conf >/dev/null && printf '%s
' 'listen_addresses = '"'"'localhost,172.31.33.195'"'"'' | sudo tee /etc/postgresql/node.conf >/dev/null && sudo chown root:postgres /etc/postgresql/*.conf && sudo chmod 0640 /etc/postgresql/*.conf screenshot=186_DBStandby_공통설정파일.png
