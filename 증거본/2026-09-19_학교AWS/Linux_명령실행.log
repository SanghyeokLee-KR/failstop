import json,pathlib,urllib.request,urllib.parse,urllib.error
base='http://127.0.0.1:9090/api/v1/'
def fetch(path):
 return json.load(urllib.request.urlopen(base+path,timeout=10))
for target in fetch('targets')['data']['activeTargets']:
 print('TARGET',target['labels'].get('job'),target['health'],target.get('lastError',''))
errors=[]; count=0; filled=0
for file in sorted(pathlib.Path('/var/lib/grafana/msp-dashboards').glob('*.json')):
 d=json.loads(file.read_text())
 for p in d['panels']:
  for t in p.get('targets',[]):
   expr=t.get('expr','').replace('$customer','exchange').replace('$__rate_interval','1m')
   if not expr: continue
   count+=1
   try:
    r=fetch('query?'+urllib.parse.urlencode({'query':expr})); n=len(r['data']['result']); filled+=bool(n)
    if not n: print('EMPTY',d['uid'],p['title'])
   except Exception as e: errors.append((p['title'],str(e)))
print('QUERY_RESULTS',count,'with_data',filled,'errors',errors)
for expr in ['up{job="exchange-api"}','process_cpu_usage{job="exchange-api"}','sum(hikaricp_connections_pending{job="exchange-api"})']:
 print('LIVE',expr,fetch('query?'+urllib.parse.urlencode({'query':expr}))['data']['result'])
assert not errors

