# 실제 파일은 /etc/failstop/reporting.env, root:failstop-report 0640으로 둔다.
REPORT_BIND=127.0.0.1
REPORT_DELIVERY_ENABLED=false
REPORT_INGEST_TOKEN=REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
REPORT_TEAMS_SECRET_FILE=/etc/failstop/teams-webhook
# 웹훅의 정확한 호스트 하나만 지정한다. URL이나 서명 query를 넣지 않는다.
REPORT_TEAMS_ALLOWED_HOSTS=REPLACE_WITH_EXACT_WORKFLOWS_HOST
# PDF/HTML 제공 설정을 켠 경우 별도의 보호 파일에 서명 키를 보관한다.
# REPORT_ARTIFACT_KEY_FILE=/etc/failstop/report-artifact-key
# Gemini는 config의 analyzer=gemini와 이 보호 파일을 사용한다. 키를 URL이나 명령 인수에 넣지 않는다.
# REPORT_AI_KEY_FILE=/etc/failstop/gemini-key
# 원격 AI는 config의 analyzer=remote와 아래 세 값이 모두 필요하다.
# REPORT_AI_URL=https://analysis.example.invalid/operations
# REPORT_AI_ALLOWED_HOSTS=analysis.example.invalid
# REPORT_AI_KEY=REPLACE_WITH_SECRET
