# OPS01 방화벽 유닛. 02-정본결정.md 4절이 정한 이름과 경로를 쓴다.
# 예전 이름 failstop-firewall.service 는 쓰지 않는다. 계통을 둘로 만들지 않기 위해서다.
#
# 원본은 failstop/deploy/linux/systemd/failstop-firewall.service 이며 바꾼 곳은 두 가지다.
#   1. Before 대상을 failstop-ssh.service docker.service 에서 배포판 기본 sshd.service 로 바꿨다.
#      VM 에는 failstop-ssh.service 도 docker.service 도 없다. systemd 는 없는 유닛에 대한
#      Before 를 조용히 무시하므로 그대로 두면 방화벽이 SSH 보다 먼저 선다는 순서가 성립하지 않는다.
#   2. 규칙 경로를 /etc/failstop/firewall.nft 에서 /etc/vm-lab/firewall.nft 로 바꿨다.
#
# 공통 절차 00-common-setup.sh 가 만드는 같은 이름의 유닛과 본문이 같다.
# 어느 쪽이 먼저 설치되든 규칙 파일과 유닛 이름이 하나로 유지된다.
# 중지해도 규칙을 지우지 않는다. 규칙을 내리려면 nft delete table inet vmlab 을 직접 실행한다.
#
# 배치 위치: /etc/systemd/system/vm-lab-firewall.service (root:root 0644)
[Unit]
Description=VM lab host firewall (nftables)
Before=sshd.service
After=local-fs.target
ConditionPathExists=/etc/vm-lab/firewall.nft

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/vm-lab/firewall.nft
ExecReload=/usr/sbin/nft -f /etc/vm-lab/firewall.nft

[Install]
WantedBy=multi-user.target
