# APP01/APP02의 /etc/exchange/app.env 원본이다.
# 원본은 failstop/deploy/linux/app/app.env.school-private 이며 VM에서 바꾼 것은 다음과 같다.
#   - SERVER_ADDRESS와 MANAGEMENT_SERVER_ADDRESS를 127.0.0.1에서 각 노드의 lab-lan 주소로 바꿨다.
#     학교에서는 두 포트를 루프백에 두고 Nginx 9101 프록시로 지표를 냈지만, VM에서는 8081을
#     lab-lan에 직접 열고 nftables로 OPS01만 허용한다. 그래서 지표 프록시를 쓰지 않는다.
#   - SPRING_DATASOURCE_URL의 172.31.33.195를 DB01의 192.168.10.31로, 인증서 경로를
#     /etc/exchange/primary.crt에서 /etc/exchange/db01.crt로 바꿨다.
#   - EXCHANGE_CORS_ALLOWED_ORIGINS와 APP_WS_ALLOWED_ORIGINS를 EDGE01 오리진 자리표시자로 바꿨다.
#     들어갈 값은 02-정본결정.md 3절이 정한 정본 진입 오리진 https://192.168.56.11 이다.
#     작업 PC 브라우저가 host-only 주소로 들어오므로 Origin 헤더가 그 값이 된다. lab-lan 주소인
#     https://192.168.10.11 을 넣으면 두 검사가 모두 막는다.
#   - EXCHANGE_TRUSTED_PROXIES를 새로 넣었다. 학교 파일에는 없고, 미지정이면 prod가 루프백만
#     신뢰 프록시로 보아 EDGE01이 전달한 X-Forwarded-For를 버린다.
# 커넥션 풀 크기와 나머지 키는 학교 파일 값을 그대로 둔다.
#
# 아래 밑줄 두 개로 감싼 자리표시자는 20-app-setup.sh 가 채운다. 채우는 키는 여섯 개이고
# 값은 노드 번호와 명령 인자에서 온다. SERVER_ADDRESS와 MANAGEMENT_SERVER_ADDRESS는 노드의
# lab-lan 주소, SPRING_DATASOURCE_URL은 --db-url, 두 오리진 키는 --origin,
# EXCHANGE_TRUSTED_PROXIES는 EDGE01 주소의 자바 정규식이다.
# --origin 을 주지 않으면 스크립트가 정본 진입 오리진을 넣고 그 사실을 화면에 적는다.
# 채우지 못한 자리표시자가 남으면 스크립트가 설치를 중단한다.
#
# 비밀 값은 이 파일에 넣지 않는다. DB 비밀번호, 마스터키, 페퍼, 세션 시드는
# /etc/exchange/app-secret.env 에 root:root 0600으로 따로 둔다.
#
# 배치 위치: /etc/exchange/app.env (root:exchange 0640)
SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=__LAN_IP__
SERVER_PORT=8080
MANAGEMENT_SERVER_ADDRESS=__LAN_IP__
MANAGEMENT_SERVER_PORT=8081

# P95 응답시간 패널용 히스토그램 버킷. Actuator 기본은 summary 라 _count/_sum 만 나오고
# _bucket 이 없어 histogram_quantile 이 값을 내지 못한다. 대상 패널은 msp-dashboards-vm 의
# 10-msp-overview 와 11-msp-service 에 있는 P95 네 개다.
# 환경변수 낱개(MANAGEMENT_METRICS_DISTRIBUTION_...) 대신 SPRING_APPLICATION_JSON 을 쓰는 이유는
# 점 표기를 그대로 넘겨 완화 바인딩의 철자 해석에 기대지 않기 위해서다.
# 같은 형태를 Docker 검증에서 이미 썼다(deploy/compose.node-app.yml:16).
# 2026-09-22 APP02 에서 실측했다. 이 값을 넣고 재기동하니 TYPE 선언이 summary 에서
# histogram 으로 바뀌고 요청 한 건에 버킷 69계열이 생겼다.
# 다만 버킷은 관측이 있어야 쌓인다. 이 실습망에는 상시 요청원이 없어 설정만으로
# 패널이 채워지지는 않는다. 시장 봇이나 주기 조회를 세운 뒤에 값이 보인다.
SPRING_APPLICATION_JSON='{"management.metrics.distribution.percentiles-histogram.http.server.requests":true,"management.metrics.distribution.minimum-expected-value.http.server.requests":"1ms","management.metrics.distribution.maximum-expected-value.http.server.requests":"30s"}'
SPRING_DATASOURCE_URL=__DB_URL__
SPRING_DATASOURCE_USERNAME=exchange_app
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=16
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=4
EXCHANGE_ENGINE_APPEND_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=14
EXCHANGE_ENGINE_APPEND_DATASOURCE_HIKARI_MINIMUM_IDLE=2
EXCHANGE_ENGINE_LEASE_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=2
EXCHANGE_ENGINE_LEASE_DATASOURCE_HIKARI_MINIMUM_IDLE=1
SPRING_FLYWAY_ENABLED=false
EXCHANGE_ENGINE_ENABLED=true
EXCHANGE_HARNESS_ENABLED=false
EXCHANGE_ADMIN_ENABLED=false
EXCHANGE_CORS_ALLOWED_ORIGINS=__ORIGIN__
APP_WS_ALLOWED_ORIGINS=__ORIGIN__
EXCHANGE_TRUSTED_PROXIES=__TRUSTED_PROXY__
