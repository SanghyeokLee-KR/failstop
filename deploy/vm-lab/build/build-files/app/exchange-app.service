[Unit]
Description=Exchange API and matching engine
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=exchange
Group=exchange
WorkingDirectory=/var/lib/exchange
EnvironmentFile=/etc/exchange/app.env
EnvironmentFile=/etc/exchange/app-secret.env
ExecStart=/usr/bin/java -Duser.timezone=UTC -Xms256m -Xmx768m -XX:+ExitOnOutOfMemoryError -jar /opt/exchange/current/app.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/exchange
MemoryMax=1400M
TasksMax=512
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=exchange-app

[Install]
WantedBy=multi-user.target
