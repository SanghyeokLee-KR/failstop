# DB 노드(DB01·DB02)용 node_exporter 유닛.
# systemd 수집기의 unit-include 목록은 이 VM에서 실제로 도는 서비스만 남겼다.
# exchange-app 과 exchange-bots 를 뺀 이유는 DB 노드에 앱도 봇도 없기 때문이다.
# prometheus 와 grafana-server 도 같은 이유로 뺐다. 그 둘은 OPS01에만 있다.
# 대신 이 노드가 실제로 돌리는 postgres_exporter 와 방화벽 유닛 vm-lab-firewall 을 넣었다.
# 배포판 nftables.service 는 쓰지 않지만 되살아나면 바로 보이도록 목록에 남긴다.
# 00-common-setup.sh 의 공통 목록과 같은 기준이며, 그 절차를 먼저 적용한 VM에서는
# 30·31 스크립트가 이 파일을 설치하지 않고 공통 유닛을 그대로 둔다.
# 30-db-primary-setup.sh 는 postgresql 을 실제 유닛 이름(PGDG는 postgresql-17)으로
# 바꾸는 드롭인을 따로 놓는다. 이 파일의 정규식은 그 드롭인의 출발점이다.
[Unit]
Description=Linux host metrics
After=network-online.target
Wants=network-online.target

[Service]
User=node_exporter
Group=node_exporter
EnvironmentFile=/etc/node_exporter/listen.env
# 2026-09-22: --collector.pressure 를 뺐다. 이 커널에는 PSI 가 없다.
# /proc/pressure 가 없고 /proc/cmdline 에 psi= 도 없어 이 수집기는 매 수집마다 실패했다.
# 그 결과 LinuxCollectorFailed 경보가 여섯 대에서 상시 발화했고, 이 관제 시스템이 내는
# 유일한 경보가 영원히 풀리지 않는 오탐이 됐다. 오탐이 상주하면 진짜 경보를 가린다.
# node_pressure_* 를 쓰는 대시보드나 경보 규칙은 없으므로 빼도 잃는 화면이 없다.
# PSI 지표를 쓰기로 하면 여섯 대의 부팅 인자에 psi=1 을 넣고(ks/*.ks 의 bootloader --append 포함)
# /proc/pressure/cpu 가 값을 내는 것을 확인한 뒤 이 인자를 되돌린다.
# 학교 AWS 의 Amazon Linux 2023 은 PSI 기본값이 다를 수 있으므로
# failstop/deploy/linux/observability 의 유닛은 그쪽에서 확인한 뒤 따로 판단한다.
# 2026-09-22: textfile 수집기를 켠다. 백업 같은 배치 작업이 .prom 파일을 써 두면
# node_exporter 가 그 값을 함께 내보내는 경로다. 15-msp-db-replication 의
# '백업 성공 · 경과 시간' 패널 두 개가 failstop_backup_last_success_timestamp_seconds 를
# 조회하는데 이 수집기가 없으면 지표가 올라올 길 자체가 없었다.
# 켠다고 값이 생기지는 않는다. 쓰는 쪽(백업 작업)이 VM 에 아직 배포돼 있지 않다.
# 디렉터리는 비어 있어도 되고 없으면 node_exporter 가 경고만 낸다.
# ProtectSystem=strict 이지만 읽기는 막지 않으므로 별도 ReadWritePaths 가 필요 없다.
ExecStart=/usr/local/bin/node_exporter --web.listen-address=${NODE_EXPORTER_ADDRESS}:9100 --collector.disable-defaults --collector.cpu --collector.meminfo --collector.filesystem --collector.diskstats --collector.netdev --collector.netstat --collector.sockstat --collector.loadavg --collector.stat --collector.time --collector.uname --collector.vmstat --collector.filefd --collector.textfile --collector.textfile.directory=/var/lib/node_exporter/textfile --collector.systemd --collector.systemd.unit-include=(sshd|chronyd|nftables|vm-lab-firewall|postgresql|postgres_exporter|node_exporter)[.]service
Restart=on-failure
RestartSec=5
MemoryMax=128M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
