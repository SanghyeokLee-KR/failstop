      "targets": [
        {
          "refId": "A",
          "expr": "max(100 * (1 - ((node_filesystem_avail_bytes{customer=\"$customer\",environment=\"$environment\",job=~\"linux-host|linux\",node=~\"$node\",mountpoint=\"/\",fstype=~\"xfs|ext4\"}) and on(instance,job) ((up{customer=\"$customer\",environment=\"$environment\",job=~\"linux-host|linux\",node=~\"$node\"} == 1) and (time() - timestamp(up{customer=\"$customer\",environment=\"$environment\",job=~\"linux-host|linux\",node=~\"$node\"}) < 90))) / ((node_filesystem_size_bytes{customer=\"$customer\",environment=\"$environment\",job=~\"linux-host|linux\",node=~\"$node\",mountpoint=\"/\",fstype=~\"xfs|ext4\"}) and on(instance,job) ((up{customer=\"$customer\",environment=\"$environment\",job=~\"linux-host|linux\",node=~\"$node\"} == 1) and (time() - timestamp(up{customer=\"$customer\",environment=\"$environment\",job=~\"linux-host|linux\",node=~\"$node\"}) < 90)))))",
          "legendFormat": "{{node}}",
