  "templating": {
    "list": [
      {
        "name": "customer",
        "label": "고객사",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "refresh": 1,
        "query": "label_values(up{role=~\"app|reader|data|standby|probe\"}, customer)",
        "current": {
          "text": "exchange",
          "value": "exchange"
        }
      },
      {
        "name": "environment",
        "label": "환경",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "refresh": 1,
        "query": "label_values(up{customer=\"$customer\",role=~\"app|reader|data|standby|probe\"}, environment)",
        "current": {
          "text": "aws",
          "value": "aws"
        },
        "options": []
      },
      {
        "name": "node",
        "label": "서버",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up{customer=\"$customer\",environment=\"$environment\",job=~\"linux-host|linux\"}, node)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "고객 경보",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": true,
        "iconColor": "red",
        "expr": "(ALERTS{customer=\"$customer\",environment=\"$environment\",role=~\"app|reader|data|standby|probe\",component!=\"reporting\",alertstate=\"firing\"} and (time() - timestamp(ALERTS{customer=\"$customer\",environment=\"$environment\",role=~\"app|reader|data|standby|probe\",component!=\"reporting\",alertstate=\"firing\"}) < 90))",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{node}} · {{severity}}"
      }
    ]
  },
