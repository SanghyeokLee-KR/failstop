# 관리콘솔 관제센터 서버(/admin/v1/msp/**)를 켤 때의 설정 예시다. 어느 배포도 이 파일을 읽지 않는다.
# 켜려면 admin.env.school처럼 실제로 읽는 env 파일에 필요한 줄만 옮기고, 적용 전에 관제센터 2단계 설계 11절의
# 환경별 조건(V70~V73 적용 순서, 용량 보호와 관리 JVM의 관계)과 승인 절차를 먼저 확인한다.
# 설정 키와 기본값은 docs/reference/architecture/MSP_관제센터_2단계_설계.md 3절이 기준이다.

# 모듈 스위치. 기본은 꺼짐이고 끈 배포에서 /admin/v1/msp/** 는 404다.
EXCHANGE_MSP_ENABLED=false
# 화면 환경 배지의 원천. LOCAL_DOCKER, SCHOOL_AWS, PERSONAL_AWS 가운데 하나다.
EXCHANGE_MSP_ENVIRONMENT=SCHOOL_AWS
# 같은 호스트(bot-1) 루프백의 Prometheus·Alertmanager. 없으면 그 칸은 원천 연결 전이다.
# EXCHANGE_MSP_PROMETHEUS_URL=http://127.0.0.1:9090
# EXCHANGE_MSP_ALERTMANAGER_URL=http://127.0.0.1:9093

# AI 판단·상담 모델(온프레미스 LLM, ADR 0038). 주소를 주지 않으면 판단 주기가 돌지 않는다.
# 아래는 로컬 평가와 같은 조건의 예시이며 켜지 않은 상태로 둔다(주석). 루프백만 평문 http를 받고,
# 루프백이 아닌 주소는 https와 llm.ca-file이 필요하다. '-cloud'·':cloud' 원격 모델은 allow-remote 없이는 거부된다.
# EXCHANGE_MSP_LLM_PROVIDER=ollama-native
# EXCHANGE_MSP_LLM_BASE_URL=http://127.0.0.1:11434
# EXCHANGE_MSP_LLM_MODEL=qwen3.6:35b-a3b
# EXCHANGE_MSP_LLM_THINK=false
# EXCHANGE_MSP_LLM_TIMEOUT=30s

# 보고 서비스(Teams 통지와 보고서 읽기). 토큰은 파일 경로로만 받는다.
# EXCHANGE_MSP_REPORTING_URL=http://172.31.44.141:9088
# EXCHANGE_MSP_REPORTING_TOKEN_FILE=<보고 서비스 Bearer 토큰 파일 경로. systemd LoadCredential 권장(설계 3절)>
# EXCHANGE_MSP_REPORTING_ENVIRONMENT=aws
