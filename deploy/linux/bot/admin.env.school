# bot.env를 읽은 다음 적용한다. 봇과 같은 JVM에서 기존 관리 기능이 실제 플릿을 제어한다.
SPRING_PROFILES_ACTIVE=prod,bots,admin
# bot.env와 같은 값이다. 관리 API(8443)도 같은 JVM의 요청 스레드와 DB 풀(최대 4)을 쓰므로
# 이 파일만 따로 교체해도 가상 스레드가 다시 켜지지 않게 둔다. ADR 0033.
SPRING_THREADS_VIRTUAL_ENABLED=false
SERVER_ADDRESS=172.31.44.141
SERVER_PORT=8443
SERVER_SSL_ENABLED=true
SERVER_SSL_CLIENT_AUTH=need
SERVER_SSL_KEY_STORE=file:/etc/exchange-bot/admin-pki/server.p12
SERVER_SSL_KEY_STORE_TYPE=PKCS12
SERVER_SSL_TRUST_STORE=file:/etc/exchange-bot/admin-pki/operators.p12
SERVER_SSL_TRUST_STORE_TYPE=PKCS12
MANAGEMENT_SERVER_SSL_ENABLED=false
MANAGEMENT_SERVER_ADDRESS=127.0.0.1
MANAGEMENT_SERVER_PORT=8081
EXCHANGE_ADMIN_ENABLED=true
EXCHANGE_ADMIN_MTLS_TRUSTED_FORWARDING=false
# 화면 폴링과 조작을 합해 운영자별 분당 60회. 기존 요청 가중치 10을 반영한다.
EXCHANGE_ADMIN_RATE_LIMIT_CAPACITY=600
EXCHANGE_CORS_ALLOWED_ORIGINS=https://www.sang.it.kr
APP_WS_ALLOWED_ORIGINS=https://www.sang.it.kr
SPRING_WEB_RESOURCES_ADD_MAPPINGS=false
