# 엣지 nginx. TLS 종단과 앱 노드 분산을 맡는다.
#
# 카오스 스택의 harness/nginx/nginx.conf와 다른 점 셋이다.
#
#   1. resolver가 Docker 내장 DNS(127.0.0.11)가 아니다. 클라우드에서는 앱 노드가 다른
#      호스트라 컨테이너 DNS가 그 이름을 모른다. VPC 리졸버(.2 주소)를 쓰거나 IP를 직접
#      박는다. 이 템플릿은 envsubst로 주소를 주입받는다.
#
#   2. backup 정적 승계를 쓰지 않는다. 현행은 api-1 1차 / api-2 backup이라 평시 분산이
#      0이고, 강등 노드가 업스트림에서 안 빠져 POST 실패 바닥이 남는다(기획안 §6.11).
#      대신 조회는 least_conn 분산, 쓰기는 리더 단독으로 가른다.
#      리더 판별은 사이드카가 upstream-leader.conf를 갱신한다. 오픈소스 nginx에는
#      능동 health_check가 없어 그 방식이 필요하다.
#
#   3. TLS를 종단한다. 카오스 스택은 평문 8080이었다.
#
# 미검증이다. 실제 EC2에서 기동한 적이 없다.

# exchange_leader upstream은 별도 파일이 정의한다(conf.d/upstream-leader.conf).
# nginx 기본 설정이 conf.d/*.conf를 이미 자동 로드하므로 여기서 include하지 않는다.
# include를 걸면 같은 파일이 두 번 읽혀 duplicate upstream으로 기동이 막힌다(실측).
#
# 그 파일은 사이드카가 2초 주기로 갱신한다. 두 노드의 readiness를 폴링해 리더를
# 판별한다. 팔로워는 설계상 503(REFUSING_TRAFFIC)이라 그대로 판별이 된다.
# 부트스트랩이 빈 파일이라도 만들어야 nginx가 기동한다.

upstream exchange_read {
    # 조회는 두 노드로 분산한다. 평시 분산 0을 해소하는 자리다.
    zone exchange_read 64k;
    least_conn;
    server ${APP_1_HOST}:8080 max_fails=1 fail_timeout=2s;
    server ${APP_2_HOST}:8080 max_fails=1 fail_timeout=2s;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name ${PUBLIC_DOMAIN};

    # Let's Encrypt HTTP-01만 평문으로 받는다. 그 외는 전부 301이다.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PUBLIC_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${PUBLIC_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PUBLIC_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # 관리 평면과 하네스는 라우팅하지 않는다. 외부 노출 대상이 아니다.
    # 접근은 SSM 포트 포워딩으로 한다(기획안 §6.6).
    location ~ ^/(admin|harness|actuator)/ {
        return 404;
    }

    # WebSocket. heartbeat 10s/10s라 idle 타임아웃이 발생하지 않는다.
    location /ws/ {
        proxy_pass http://exchange_read;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    # 쓰기는 리더 단독이다. 단일 라이터 구조라 팔로워로 보내면 503이 난다.
    location ~ ^/api/v1/(orders|transfers) {
        limit_except GET {
            proxy_pass http://exchange_leader;
        }
        proxy_pass http://exchange_read;
        include /etc/nginx/conf.d/proxy-common.conf;
    }

    location /api/ {
        proxy_pass http://exchange_read;
        include /etc/nginx/conf.d/proxy-common.conf;
    }
}
