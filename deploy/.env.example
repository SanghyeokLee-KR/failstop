# 배포 변수 카탈로그. 값은 담지 않는다. 이 파일이 커밋 대상이고 실제 값은 노드별
# .env 또는 SSM Parameter Store에서 온다.
#
# 이름 규약. 카오스 스택의 CHAOS_ 접두를 배포에서는 쓰지 않는다. 그 접두는 로컬 실험
# 스택을 가리키는 이름이고, 배포는 실험면이 아니라 상시면이다.

# ---- 이미지 ----
# GHCR digest 고정. 태그가 아니라 digest를 쓴다. 태그는 재푸시로 내용이 바뀌므로
# 롤백 대상이 무엇인지 확정되지 않는다.
APP_IMAGE=

# ---- 노드 주소 ----
# 로컬은 compose 서비스명, 클라우드는 프라이빗 IP를 같은 변수에 넣는다.
# 이 변수화가 다중 호스트 이식의 핵심이다. 현행 compose는 chaos-pg:5432를 직접 박아
# 단일 호스트 네트워크를 전제한다(실측 결합 5곳).
DB_HOST=
DB_PORT=5432
APP_1_HOST=
APP_2_HOST=

# ---- DB ----
DB_NAME=exchange
DB_ADMIN_USER=exchange_owner
DB_ADMIN_PASSWORD=
DB_USER=exchange_app
DB_PASSWORD=
READ_DB_USER=exchange_read
READ_DB_PASSWORD=
BOT_DB_USER=exchange_bot
BOT_DB_PASSWORD=

# 기본은 로컬 전용. AWS에서는 각 호스트의 RFC1918 사설 IPv4를 명시한다.
DB_BIND_IP=127.0.0.1
DB_LISTEN_PORT=5432
# 같은 PC에서 두 노드를 연습할 때만 5433. 별도 DB 호스트에서는 5432로 바꾼다.
STANDBY_LISTEN_PORT=5433
APP_BIND_IP=127.0.0.1
MGMT_BIND_IP=127.0.0.1
APP_PORT=8080
MGMT_PORT=8081

# 연결 예산은 사용량 실측이 아닌 최댓값이다. 메모리 적정성은 부하로 확인해야 한다.
# (ENGINE_NODE_COUNT + ENGINE_ROLLOUT_SURGE) * (32+14+2)
# + READ_MAX_NODES * (8+1+1) + BOT_NODE_COUNT * (8+1+1)
# + DB_OPERATIONS_CONNECTIONS + MAX_WAL_SENDERS = 188 <= 200 - 3.
DB_MAX_CONNECTIONS=200
DB_RESERVED_CONNECTIONS=3
DB_OPERATIONS_CONNECTIONS=10
DB_MEMORY=2g
ENGINE_NODE_COUNT=2
ENGINE_ROLLOUT_SURGE=1
APP_DB_POOL_MAX=32
APP_DB_POOL_IDLE=8
APP_APPEND_POOL_MAX=14
APP_LEASE_POOL_MAX=2
READ_MAX_NODES=2
READ_DB_POOL_MAX=8
BOT_NODE_COUNT=1
BOT_DB_POOL_MAX=8
MAX_WAL_SENDERS=4
MAX_REPLICATION_SLOTS=4
# SQL 명령별 통계. 기존 preload 모듈이 있으면 목록을 보존해 추가한다.
# 변경 후 DB 재시작과 관리자 CREATE EXTENSION이 필요하다. 절차는 observability/README.md를 따른다.
PG_SHARED_PRELOAD_LIBRARIES=pg_stat_statements

# 복제(ADR 0024). primary 1 + standby 1, 비동기 스트리밍이다.
# REPL_PASSWORD 는 primary 의 초기화 스크립트와 standby 의 베이스백업이 함께 쓴다. 두 노드의
# .env 에 같은 값이 있어야 한다. 이 롤은 LOGIN REPLICATION 만 갖고 데이터 권한이 없다.
# DB_HOST 는 standby 에서 primary 주소로 읽힌다. 노드마다 값이 다르다.
REPL_USER=replicator
REPL_PASSWORD=
REPL_SLOT=standby_1
# 복제 접속을 허용할 대역. pg_hba 에 들어간다. 기본값은 VPC 대역이다.
REPL_CIDR=10.0.0.0/16
# 슬롯이 끊긴 standby 때문에 primary 디스크가 차는 것을 막는 상한. 넘으면 슬롯이 무효가 되고
# standby 는 베이스백업을 다시 받는다. 가용성을 디스크보다 앞에 둔다.
MAX_SLOT_WAL_KEEP=4GB

# ---- 시크릿 ----
# base64 32바이트. blank면 노드가 기동하지 않는다(StartupMasterKeyValidator).
# 그 게이트가 없던 시절 --env-file 누락으로 인증이 3시간 49분간 100% 500이었다.
MASTER_KEY_BASE64=

# ---- prod 부팅 필수 (실측 2026-08-30) ----
# 아래 둘이 없으면 부팅이 중단된다. prod가 저장소에서 한 번도 켜진 적이 없어
# 배포 당일 처음 발견될 자리였다. 값은 base64 32바이트.
PASSWORD_PEPPER_BASE64=
SESSION_SEED_BASE64=
# 화이트리스트. 미지정이면 prodCorsFilter 생성이 실패한다.
CORS_ALLOWED_ORIGINS=https://sang.it.kr
# 기본값이면 중단된다. 운영 오리진을 명시한다.
WS_ALLOWED_ORIGINS=https://sang.it.kr

# ---- 프로파일 ----
# 상시면 앱 노드는 prod. 관리 포트가 8081로 분리된다(application.yml:127).
SPRING_PROFILES_ACTIVE=prod
EXCHANGE_ENGINE_ENABLED=true
# Java 정규식이다(CIDR 아님). 원격 배포에서는 실제 ALB 서브넷만 신뢰하도록 바꾼다.
EXCHANGE_TRUSTED_PROXIES=127\.0\.0\.1
SIM_BASE_URL=

# ---- 도메인 ----
# 정적 export가 빌드 타임에 인라인하므로 웹 빌드 전에 확정돼야 한다.
PUBLIC_DOMAIN=sang.it.kr

# Let's Encrypt 만료 통지를 받을 주소. deploy/issue-cert.sh 가 요구한다.
# 값이 없으면 최초 발급이 중단된다. 인증서 만료는 전면 접속 불가로 나타나므로
# 도달 가능한 주소여야 한다.
LETSENCRYPT_EMAIL=

# ---- 관측 ----
# 스크레이프 대상. 컨테이너명이 아니라 노드 주소를 쓴다.
PROMETHEUS_TARGETS=
