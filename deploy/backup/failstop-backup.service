[Unit]
Description=Failstop PostgreSQL backup
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/failstop/deploy/backup/backup.py backup --env /etc/failstop/backup.env
TimeoutStartSec=35min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/failstop /var/lib/failstop/metrics
