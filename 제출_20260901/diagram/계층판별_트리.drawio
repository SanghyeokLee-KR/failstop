        <mxCell id="170" value="판정표의 원은 프로브 응답이다. 초록이 성공, 빨강이 실패다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9.5;fontColor=#5C6B75;fontStyle=0;fontFamily=Malgun Gothic;" vertex="1" parent="1">
