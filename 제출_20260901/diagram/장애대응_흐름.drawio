        <mxCell id="135" value="셋 중 하나라도 아니면 자동화하지 않고 알림까지만 자동으로 둔다" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#5C6B75;fontStyle=1;fontFamily=Malgun Gothic;" vertex="1" parent="1">
