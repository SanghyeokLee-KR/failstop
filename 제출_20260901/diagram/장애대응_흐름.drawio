        <mxCell id="138" value="색은 손이 닿는 정도다. 도면 1의 색은 노드 상태를 뜻하므로 두 도면에서 같은 색이 다른 축이다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9.5;fontColor=#5C6B75;fontStyle=0;fontFamily=Malgun Gothic;" vertex="1" parent="1">
