        <mxCell id="151" value="" style="line;html=1;strokeColor=#D0D7DC;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="892" width="0" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="152" value="커널 계층 주입은 이 평면 전용이다. 클라우드 노드에 걸면 SSM 접근 경로가 같은 네트워크를 타서 노드를 통째로 잃는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9.5;fontColor=#3C4750;fontStyle=0;fontFamily=Malgun Gothic;" vertex="1" parent="1">
          <mxGeometry x="984" y="894" width="990" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="153" value="두 평면을 잇는 것은 상시 터널이 아니라 같은 GHCR digest 와 저장소에 커밋한 verdict 파일이다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9.5;fontColor=#3C4750;fontStyle=0;fontFamily=Malgun Gothic;" vertex="1" parent="1">
          <mxGeometry x="984" y="912" width="990" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="154" value="검증면이 탐색하고, 증명면이 재현하고, 상시면이 서비스한다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9.5;fontColor=#16191F;fontStyle=1;fontFamily=Malgun Gothic;" vertex="1" parent="1">
          <mxGeometry x="984" y="934" width="990" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="155" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#5C6B75;strokeWidth=1.1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="992" width="1360" height="124" as="geometry"/>
        </mxCell>
        <mxCell id="156" value="Known Limitations" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12.5;fontColor=#5C6B75;fontStyle=1;fontFamily=Malgun Gothic;" vertex="1" parent="1">
          <mxGeometry x="36" y="1000" width="200" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="157" value="숨기지 않는다. 이 목록이 남은 작업의 정의다" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9.5;fontColor=#5C6B75;fontStyle=0;fontFamily=Malgun Gothic;" vertex="1" parent="1">
          <mxGeometry x="190" y="1000" width="500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="158" value="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#5C6B75;fontStyle=1;fontFamily=Malgun Gothic;" vertex="1" parent="1">
          <mxGeometry x="44" y="1026" width="16" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="159" value="Application 계층만 2 AZ 다. 전체 AZ 장애 내성은 미성립이고 AZ-a 상실 시 DB 승격 소요는 미측정이다" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9.5;fontColor=#3C4750;fontStyle=0;fontFamily=Malgun Gothic;" vertex="1" parent="1">
          <mxGeometry x="64" y="1026" width="1300" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="160" value="2" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#5C6B75;fontStyle=1;fontFamily=Malgun Gothic;" vertex="1" parent="1">
          <mxGeometry x="44" y="1046" width="16" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="161" value="PostgreSQL 승격이 수동이다. Patroni · etcd 설정 파일 0건. primary 가 자동 복구 기준의 단일 장애점이다" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9.5;fontColor=#3C4750;fontStyle=0;fontFamily=Malgun Gothic;" vertex="1" parent="1">
          <mxGeometry x="64" y="1046" width="1300" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="162" value="3" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#5C6B75;fontStyle=1;fontFamily=Malgun Gothic;" vertex="1" parent="1">
          <mxGeometry x="44" y="1066" width="16" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="163" value="클라우드 배포와 카오스 실측이 NOT RUN 이다. RTO · RPO · Ledger 수치는 전부 로컬 카오스 스택 실측이다" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9.5;fontColor=#3C4750;fontStyle=0;fontFamily=Malgun Gothic;" vertex="1" parent="1">
          <mxGeometry x="64" y="1066" width="1300" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="164" value="4" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#5C6B75;fontStyle=1;fontFamily=Malgun Gothic;" vertex="1" parent="1">
          <mxGeometry x="44" y="1086" width="16" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="165" value="상시면 관측 스택 컴포즈 정의 0건. 로컬 하네스는 통지 경로가 배선됐고 수신 주소만 비어 있다. E1 · E2 · E5 · E9 는 상시면 이식 불가라 카오스는 로컬 전속이다" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9.5;fontColor=#3C4750;fontStyle=0;fontFamily=Malgun Gothic;" vertex="1" parent="1">
          <mxGeometry x="64" y="1086" width="1300" height="16" as="geometry"/>
        </mxCell>
