# Patroni 실험 스택 변수 예시(Patroni 설계 1절 전제). 복사해서 쓴다.
#   Copy-Item harness/patroni/.env.patroni.example harness/patroni/.env.patroni
# .env.patroni 는 .gitignore(.env.*)로 추적하지 않는다. 이 example 만 커밋한다.
# 아래 비밀번호와 키는 폐기용 스택 전용 자리표시 값이다. 실제 환경(학교·개인 AWS, 카오스 스택)의 비밀을 넣지 않는다.

# 앱 이미지 태그. 다른 작업의 태그(exchange-chaos-app:local, :pml 등)와 겹치지 않게 이 스택 전용 태그를 쓴다.
PATRONI_APP_IMAGE=exchange-chaos-app:patroni
# DB 이미지. harness/patroni/Dockerfile 로 만든다(compose build).
PATRONI_DB_IMAGE=exchange-patroni-db:local

# Patroni 가 부트스트랩 때 만드는 계정과 REST 변경 메서드의 인증.
PATRONI_SUPERUSER_PASSWORD=patroni-local-superuser
PATRONI_REPLICATION_PASSWORD=patroni-local-replication
PATRONI_RESTAPI_USERNAME=patroni
PATRONI_RESTAPI_PASSWORD=patroni-local-rest

# 앱 계정(post_bootstrap.sh 가 만든다)과 수집기 계정(pg_monitor).
EXCHANGE_DB_USER=exchange
EXCHANGE_DB_PASSWORD=exchange-local
EXCHANGE_MONITOR_USER=exchange_monitor
EXCHANGE_MONITOR_PASSWORD=monitor-local

# 앱 노드 공유 마스터키. 32바이트 zero 의 base64(더미)다. 빈 값이면 StartupSecretValidator 가 기동을 막는다.
PATRONI_MASTER_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# 리스 파라미터와 봇 목표 OPS. 카오스 스택 기본값과 같다(harness/.env.chaos.example 의 근거).
PATRONI_LEASE_TTL=6s
PATRONI_LEASE_TICK=2s
PATRONI_BOTS_OPS=10

# 앱 프로파일. patroni 가 쓰기 가능 탐지와 append 풀 소켓 제한을 켠다.
PATRONI_SPRING_PROFILES=dev,chaos-monkey,prod-timeouts,patroni
