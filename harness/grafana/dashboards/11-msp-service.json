{
  "uid": "msp-service",
  "title": "서비스 상세",
  "tags": [
    "msp"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "customer",
        "label": "고객사",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up, customer)",
          "refId": "customer"
        },
        "refresh": 1,
        "current": {},
        "includeAll": false,
        "multi": false
      },
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{customer=\"$customer\"}, service)",
          "refId": "service"
        },
        "refresh": 1,
        "current": {},
        "includeAll": true,
        "multi": false
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "title": "MSP 대시보드",
      "tags": [
        "msp"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link"
    },
    {
      "type": "link",
      "title": "MSP 종합",
      "url": "/d/msp-overview?${__url_time_range}",
      "icon": "arrow-left",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "들어오는 양",
