          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by(node)(rate(http_server_requests_seconds_count{customer=\"$customer\",job=\"exchange-api\"}[1m]))",
