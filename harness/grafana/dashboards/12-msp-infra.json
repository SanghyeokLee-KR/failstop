{
  "uid": "msp-infra",
  "title": "인프라 상세",
  "tags": [
    "msp"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "customer",
        "label": "고객사",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up, customer)",
          "refId": "customer"
        },
        "refresh": 1,
        "current": {},
        "includeAll": false,
        "multi": false
      },
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{customer=\"$customer\"}, service)",
          "refId": "service"
        },
        "refresh": 1,
        "current": {},
        "includeAll": true,
        "multi": false
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "title": "MSP 대시보드",
      "tags": [
        "msp"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link"
    },
    {
      "type": "link",
      "title": "MSP 종합",
      "url": "/d/msp-overview?${__url_time_range}",
      "icon": "arrow-left",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "노드",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "컨테이너 CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "호스트 코어 1개가 100 이다.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "max": null,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "gradientMode": "opacity"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "max by(name)(container_cpu_percent{name=~\"ex-.*\"})",
          "legendFormat": "{{name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "컨테이너 메모리",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "max": 100,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
