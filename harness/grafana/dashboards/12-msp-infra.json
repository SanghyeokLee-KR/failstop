        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "max by(name)(container_mem_bytes{name=~\"ex-.*\"})/clamp_min(max by(name)(container_mem_limit_bytes{name=~\"ex-.*\"}),1)*100",
          "legendFormat": "{{name}}",
          "refId": "A",
