{
  "uid": "db-ha-patroni",
  "title": "DB 자동 전환(Patroni)",
  "description": "Patroni 실험 스택(harness/patroni)의 Prometheus 를 읽는다. 카오스 스택에는 이 지표가 없다. 설계: docs/reference/architecture/DB_자동전환_Patroni_설계.md 7절",
  "tags": [
    "patroni",
    "db-ha"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "거래 상태",
      "description": "어느 앱 노드든 ACTIVE 가 아니면 거래 일시 중단이다(TradingSuspended 와 같은 식).",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ACTIVE",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "중단",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(exchange_write_availability_state{state!=\"ACTIVE\"}) or vector(0)",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ]
    },
    {
