        "query": {
          "query": "label_values(up{job=~\"exchange-api|linux-host|postgres|blackbox-http\",role=~\"app|reader|data|standby|probe\"},customer)",
          "refId": "customer"
        },
        "refresh": 1,
        "current": {
          "text": "exchange",
          "value": "exchange"
        },
        "multi": false,
        "includeAll": false
      },
      {
        "name": "environment",
        "label": "환경",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{customer=\"$customer\",job=~\"exchange-api|linux-host|postgres|blackbox-http\",role=~\"app|reader|data|standby|probe\"},environment)",
          "refId": "environment"
        },
        "refresh": 1,
        "current": {},
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "links": [
    {
      "type": "link",
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "title": "01 서비스 관제",
