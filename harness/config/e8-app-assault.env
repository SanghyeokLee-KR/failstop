# docs §3 E8 앱 내부 지연/예외 폭풍(Chaos Monkey). scripts/e8-app-assault.ps1이 읽는다.
# 판정: Resilience4j CB open -> fail-fast 503, 매칭 코어 무결성 비전파, 해제 후 CB 자동 복귀.
# 전제: 앱 이미지에 chaos-monkey 3.3.0 의존·프로파일과 actuator 노출이 필요하다. 현 dev 프로파일
# 이미지에 미배선이면 스크립트는 SKIP(전제 미충족)을 내고 필요한 배선을 보고한다. 무단 추가 금지.

EXPERIMENT_ID=E8
ASSAULT_NODE=chaos-api-1       # assault 대상 노드
ASSAULT_PORT=18080
WARMUP_SEC=20
# 실험별 봇 부하(lib.ps1 Set-BotOps로 워밍업에서 적용). 앞선 실험의 ops 이월을 끊는다.
# E8은 체결 게이트가 없다(판정 축이 CB 전이와 무결성 비전파). 그래도 assault 중 무결성 비전파를
# 주장하려면 매칭 경로에 쓰기가 실려 있어야 하므로 부하를 명시로 세운다.
BASE_OPS=40
MIN_TRADES_BEFORE_INJECT=10   # 워밍업 이후 증분 기준(누적 아님). assault 전 쓰기 실재 확인용
ASSAULT_TYPE=latency          # latency | exception
LATENCY_RANGE_START_MS=1000
LATENCY_RANGE_END_MS=3000
INJECT_DURATION_SEC=60
CB_RECOVERY_SEC=60            # 해제 후 CB half-open->closed 복귀 상한
