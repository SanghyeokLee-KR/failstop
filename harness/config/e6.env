# E6 폭주 + 리더 kill 복합(구 e3.env). 봇 OPS를 10배로 올린 스파이크 plateau 중 리더 kill →
# 백프레셔와 페일오버 동시 → 복구. 판정: E4 판정 + 스파이크 중 불변식 유지.
# 봇 OPS 런타임 변경 API(PUT /admin/v1/sim/rate)는 미구현(README M1-6)이라, 스파이크는
# 봇 노드를 높은 target-ops로 재기동해 재현한다(SPIKE_OPS). 정본 k6 개방루프 스파이크는
# load/order_flow.js(PROFILE=e6)가 담당하며 본 스크립트는 봇 플릿 기반 축약 재현이다.

EXPERIMENT_ID=E6
TARGET_NODE=chaos-api-1
STANDBY_NODE=chaos-api-2
WARMUP_SEC=30
BASE_OPS=40
# 봇 거버너 축(EXCHANGE_SIM_TARGET_OPS)의 기저 10배. §2-4 확정 상한 100은 외부 k6 주입 축
# (load/config/e6.env SPIKE_RATE)이라 이 값과 같은 축이 아니고 비교 대상도 아니다.
SPIKE_OPS=400
SPIKE_PLATEAU_SEC=60
KILL_AFTER_SPIKE_SEC=30       # 스파이크 plateau 진입 +30s에 kill(표준 E6 중첩 조건)
RTO_TARGET_SEC=30
POST_KILL_OBSERVE_SEC=90
