# docs §3 E9 커밋 응답 절단(멱등성 증명). scripts/e9-commit-cut.ps1이 읽는다. 페일오버 아님.
# reset_peer로 app<->pg 커밋 응답을 절단(in-doubt commit) -> 클라이언트 UNKNOWN -> 동일 키 재조회/
# 재전송 -> uq_orders_client 멱등 replay. 판정: 이중 접수 0(C07/C07'), gapless, 자산합 0, 클라 수렴.
# 창은 리스 TTL(6s) 미만이라 페일오버를 유발하지 않고 멱등에 초점을 둔다. 페일오버가 나도 판정은
# dup=0으로 독립적이라 verdict는 epoch 변화에 게이팅하지 않는다.

EXPERIMENT_ID=E9
LEADER_PROXY=pg-api1           # 리더 pg 프록시. 커밋 응답(downstream) 절단 주입점
LEADER_PORT=18080
WARMUP_SEC=30
# 실험별 봇 부하(lib.ps1 Set-BotOps로 워밍업에서 적용). 앞선 실험의 ops 이월을 끊는다.
# E9 판정의 converged(해제 후 체결 증가)와 dup=0은 쓰기가 실려야 의미가 있다. 부하를 물려받으면
# 무부하 상태에서 주입해 멱등 기제를 시험하지 않은 채 통과할 수 있다.
BASE_OPS=40
MIN_TRADES_BEFORE_INJECT=10   # 워밍업 이후 증분 기준(누적 아님)
TOXIC_TYPE=reset_peer          # reset_peer | limit_data
LIMIT_DATA_BYTES=4096          # limit_data 선택 시 바이트 상한(§3 E9)
TOXIC_WINDOW_SEC=4             # 절단 창(리스 TTL 6s 미만)
POST_OBSERVE_SEC=30            # 해제 후 클라 수렴(재조회/재전송) 관찰
