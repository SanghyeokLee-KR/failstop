# docs §3 E7 그레이 장애(행/무응답). scripts/e7-gray-pause.ps1이 읽는다.
# docker pause = freezer cgroup, 프로세스 감지 불가·TCP 생존. crash와 달리 재기동 없음.
# 판정: 승격 정상, 좀비 리더(unpause 후) stale 쓰기 0, epoch 정확히 +1, RTO < 30s.
# 종료 훅에서 docker unpause를 무조건 실행(pause는 restart 정책으로 복구 안 됨, §3).

EXPERIMENT_ID=E7
TARGET_NODE=chaos-api-1        # pause 대상(초기 리더)
STANDBY_NODE=chaos-api-2
TARGET_PORT=18080
STANDBY_PORT=28080
WARMUP_SEC=30
MIN_TRADES_BEFORE_INJECT=10
PAUSE_SEC=45                  # 동결 유지(§3 E7: 45s 후 unpause)
RTO_TARGET_SEC=30
POST_OBSERVE_SEC=90
ZOMBIE_OBSERVE_SEC=30         # unpause 후 좀비 self-shutdown/팔로워 강등 관찰 상한
