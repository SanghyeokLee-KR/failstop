# docs §3 E3 Redis 장애. scripts/e3-redis-outage.ps1이 읽는다.
# 전제: 리더십 권위는 DB leader_lease(§6.6), Redisson은 후보 조율 보조(부록 A #6).
# 현 격리 스택에는 chaos-redis 서비스·redis 프록시가 없다. 부재 시 스크립트는 SKIP을 내고
# DB-권위 리더십이 Redis 없이 성립함(=E3 전제)을 증거로 남긴다. compose 무단 추가 금지.
# 파일명 유의: 폭주+리더 kill 실험 설정은 config/e6.env(구 e3.env, M4 §0-3 개명)다.

EXPERIMENT_ID=E3
REDIS_CONTAINER=chaos-redis    # 존재 시 kill 대상
REDIS_PROXY=redis-api1         # 존재 시 reset_peer/timeout 주입 프록시(populate.json 부재)
WARMUP_SEC=10
MIN_TRADES_BEFORE_INJECT=10
RECOVERY_SEC=60                # redis 복귀 후 전 채널 정상화 상한(라이브 경로용)
POST_OBSERVE_SEC=60
