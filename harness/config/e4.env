# E4 매칭 리더 kill 실험 설정(재현용, 구 e1.env). scripts/e4-leader-kill.ps1이 읽는다.
# 판정: 유실 0 · 중복 0 · 자산합 0 · RTO < 30s.

EXPERIMENT_ID=E4
TARGET_NODE=chaos-api-1        # 참고값. 실 kill 대상은 스크립트의 Get-LeaderContainer가 정한다
STANDBY_NODE=chaos-api-2       # 참고값. 승격 관찰 포트는 감지된 리더의 반대 노드로 계산한다
WARMUP_SEC=30                  # kill 전 정상 부하 축적
MIN_TRADES_BEFORE_KILL=10      # 이 이상 체결 후 kill
RTO_TARGET_SEC=30
POST_KILL_OBSERVE_SEC=90       # 승격·체결 재개 관찰 상한
EXCHANGE_SIM_SEED=42           # 봇 결정론 시드. 봇 노드가 exchange.sim.seed(prefix exchange.sim)로 소비.
                               # 실배선: docker-compose.chaos.yml의 chaos-bots environment에
                               # EXCHANGE_SIM_SEED: ${EXCHANGE_SIM_SEED:-42} 주입 필요. 미주입 시
                               # SimProperties 기본 42로 폴백해 값은 같으나 명시 배선은 아니다.
