# E2 DB 단절 실험 설정. 리더(api-1)의 pg 프록시(pg-api1)에 blackhole(timeout=0) 주입 →
# 리스 갱신 실패 → 강등 → 스탠바이 failover → 토식 해제 후 복구.
# 판정: 유실 0(ACK 없는 주문은 재전송, ACK된 주문은 저널 존재) · C05/C06=0 · 자산합 0.

EXPERIMENT_ID=E2
TARGET_NODE=chaos-api-1
STANDBY_NODE=chaos-api-2
LEADER_PROXY=pg-api1           # toxiproxy 프록시명(리더 전용 리스너 15432)
WARMUP_SEC=30
MIN_TRADES_BEFORE_INJECT=10
TOXIC_TYPE=timeout            # timeout=0 = 연결 유지·무응답(블랙홀). 대안: down(즉시 refused)
TOXIC_DURATION_SEC=25         # 리스 TTL(6s)의 4배. 강등·failover 확정
RTO_TARGET_SEC=30
POST_OBSERVE_SEC=90
