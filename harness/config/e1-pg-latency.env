# docs §3 E1 PG 지연/지터. scripts/e1-pg-latency.ps1이 읽는다. 페일오버 아님.
# 판정은 정본 §3 E1 1차(필수) 전건이다. 무결성 위반 0, epoch 불변,
# exchange_leader_standdown_total 증가 0, 주입 중·해제 후 컨테이너 unhealthy 표본 0,
# 체결 정지 0, 해제 후 60s 내 p99 기저 복귀, status 응답 유지(오류율 < ERROR_RATE_MAX),
# 리스 갱신 행 잠금 대기 표본 0, last_renew_age 최대 < RENEW_AGE_MAX_SEC, 갱신 rejected·error 증가 0.
# 양성 축(표본 수, RowShareLock 동시 보유, 갱신 성공 수, 주입 p99 배수)이 하나라도 미달이면 FAIL이다.
# 정본 2차(429 포함 k6 주문 경로 오류율)는 이 스크립트가 측정하지 않는다. k6 order_flow.js 소관.
# 파일명 유의: 리더 kill 실험 설정은 config/e4.env(구 e1.env, M4 §0-3 개명)다.

EXPERIMENT_ID=E1
LEADER_PROXY=pg-api1           # 리더(api-1) 전용 pg 프록시(리스너 15432). 여기에 지연 주입
LEADER_PORT=18080             # 리더 노드 status 지연 표본 채취처(DB 경유 read)
WARMUP_SEC=30
MIN_TRADES_BEFORE_INJECT=10
# 실험별 봇 부하(Tier 1, lib.ps1 Set-BotOps로 적용). E1은 §3 "normal 부하" 실험이라 저부하로 둔다.
# 스택 기본(CHAOS_BOTS_OPS 40)은 지연 하에서 요청 풀을 포화시켜 errOk를 깨므로, 리더가 지연 하에도
# status를 서빙할 수 있는 저부하로 캘리브레이션한다(리스 수정으로 페일오버는 이미 제거됨).
BASE_OPS=40
# 실측 결론(2026-07-24, 리스 전용 커넥션 서버 수정 후): 리더 리스 하트비트에 전용 DB 커넥션을 부여한
# 서버 하드닝(커밋 992e59b) 이후 정본 200/100에서 리더가 페일오버하지 않는다(epoch 불변 실증). 복구
# (해제 후 4s)·무결성(0위반)도 통과(스탠바이 무결성 run·풀 32 병행). 남은 미통과 게이트는 errOk
# (오류율<0.1%) 하나뿐: downstream latency가 봇의 다중행 쿼리 결과를 패킷마다 증폭시켜 커넥션을 수 초
# 점유 -> 요청 풀(32) 포화 -> 리더 status GET이 큐잉·타임아웃(주입 200ms 오류율 99%, 30ms 32.5%). 이는
# 리스와 무관한 요청-경로 용량 한계(무제한 봇 부하)라, 지연을 0에 가깝게 낮추거나 봇 부하 제어·요청
# 백프레셔가 없으면 errOk<0.1%는 도달 불가. 값은 정본 200/100 유지. errOk 잔여는 별도 요청-경로 과제.
TOXIC_LATENCY_MS=200          # downstream latency(§3 E1)
TOXIC_JITTER_MS=100
INJECT_DURATION_SEC=120       # 지연 유지 창
LATENCY_SAMPLE_COUNT=120      # 구간별 표본 수(baseline/inject/post 배치)
SAMPLE_GAP_MS=50
ERROR_RATE_MAX=0.001          # status(면제 경로) 오류율 상한(0.1%). 1차 게이트다
P99_RECOVERY_SEC=60           # 해제 후 p99 기저 복귀 상한
P99_RECOVERY_MARGIN=2.0       # 기저 p99의 이 배수 이내(또는 기저+50ms) 복귀로 판정

# 리스 행 잠금 축(정본 §3 E1 1차, DB 설계 v2.43). 주입 창 동안 chaos-pg 직조회와 리더 스크레이프로 표본을 뜬다.
# 스택 전제는 리스 TTL 6s, 갱신 tick 2s(docker-compose.chaos.yml)다. 바뀌면 아래 값도 다시 잡는다.
LEASE_SAMPLE_GAP_MS=500       # pg_stat_activity·pg_locks 표본 주기
LEASE_SAMPLE_MIN=120          # 양성 축. 120s x 2Hz = 240 의 절반. docker exec 왕복 시간을 잰 적이 없어 여유를 크게 뒀다
LEASE_ROWSHARE_MIN=2          # 양성 축. leader_lease 쓰기 잠금이 실제로 겹친 회차만 판정한다
RENEW_AGE_SAMPLE_GAP_MS=1000  # last_renew_age 스크레이프 주기
RENEW_AGE_SAMPLE_MIN=60       # 양성 축. 120s x 1Hz = 120 의 절반. 지연 걸린 리더 스크레이프가 늦는다. 표본 0이면 최대값 판정이 공허하다
RENEW_AGE_MAX_SEC=4.0         # 1차. tick 2s의 두 배. 갱신을 한 번이라도 놓치면 넘는다
RENEW_OK_MIN=30               # 양성 축. 갱신은 고정 지연 2s 에 왕복 지연 200ms 안팎이 붙어 창 120s 에 약 53회다. 그 절반 남짓
INJECT_P99_FACTOR_MIN=10      # 양성 축. 주입 p99가 기저 p99의 이 배수 이상이어야 지연이 PG 경로에 닿은 것이다
