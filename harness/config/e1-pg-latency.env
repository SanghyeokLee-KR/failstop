# docs §3 E1 PG 지연/지터. scripts/e1-pg-latency.ps1이 읽는다. 페일오버 아님.
# 판정: 오류율 < 0.1%, 무결성 위반 0, 해제 후 60s 내 p99 기저 복귀.
# 파일명 유의: 리더 kill 실험 설정은 config/e4.env(구 e1.env, M4 §0-3 개명)다.

EXPERIMENT_ID=E1
LEADER_PROXY=pg-api1           # 리더(api-1) 전용 pg 프록시(리스너 15432). 여기에 지연 주입
LEADER_PORT=18080             # 리더 노드 status 지연 표본 채취처(DB 경유 read)
WARMUP_SEC=30
MIN_TRADES_BEFORE_INJECT=10
# 실측 결론(2026-07-24): 정본 200/100은 이 단일 PC 데모에서 비페일오버로 통과하지 못한다. downstream
# latency는 결과 패킷마다 지연을 더해 다중 행 쿼리 점유를 ~1s로 폭증시키고(주입 20ms에서도 리더 p99
# 1044ms 실측), 무제한 봇 부하와 겹쳐 풀을 고갈시켜 리더 리스 하트비트를 굶긴다 -> epoch+1 페일오버.
# 200·50·30·20 전부 페일오버(availability는 잃되 무결성은 항상 유지=CP). 근본 해결은 리스 하트비트
# 전용 커넥션(서버 리더십 변경)이라 자율 범위 밖, 별도 하드닝 과제로 분리한다. 값은 정본 200/100 유지.
# 스크립트 개선(무결성 run 스탠바이 이관)·스택 개선(풀 32)으로 크래시(타임아웃·503)는 제거돼, E1은
# 이제 무결성 유지·availability 상실을 증거로 남기며 깨끗이 판정된다(과대 지연 시 FAIL은 데모 한계).
TOXIC_LATENCY_MS=200          # downstream latency(§3 E1)
TOXIC_JITTER_MS=100
INJECT_DURATION_SEC=120       # 지연 유지 창
LATENCY_SAMPLE_COUNT=120      # 구간별 표본 수(baseline/inject/post 배치)
SAMPLE_GAP_MS=50
ERROR_RATE_MAX=0.001          # 오류율 상한(0.1%)
P99_RECOVERY_SEC=60           # 해제 후 p99 기저 복귀 상한
P99_RECOVERY_MARGIN=2.0       # 기저 p99의 이 배수 이내(또는 기저+50ms) 복귀로 판정
