# docs §3 E5 네트워크 분할(split-brain 반증, crown jewel). scripts/e5-net-partition.ps1이 읽는다.
# 판정: 이중 쓰기 0(구 epoch fencing 신규 행 0), epoch 정확히 +1, 무결성 0, 복귀 노드 팔로워 재합류.
# 정본 §3 주입명은 데모 컨테이너명(exchange-demo_default)이라 격리 스택 실명으로 정정: exchange-chaos_chaos-net/chaos-api-1.

EXPERIMENT_ID=E5
TARGET_NODE=chaos-api-1        # 분할 대상(초기 리더). 프로세스 생존, 네트워크만 격리
STANDBY_NODE=chaos-api-2
TARGET_PORT=18080             # 복귀 후 팔로워 재합류 관찰처
STANDBY_PORT=28080
NETWORK=exchange-chaos_chaos-net
WARMUP_SEC=30
# 실험별 봇 부하(lib.ps1 Set-BotOps로 워밍업에서 적용). 앞선 실험의 ops 이월을 끊는다.
# E6 스파이크(400) 직후나 페일오버 드레인 직후에 돌려도 같은 부하에서 판정하게 만드는 값이다.
BASE_OPS=40
MIN_TRADES_BEFORE_INJECT=10   # 워밍업 이후 증분 기준(누적 아님)
PARTITION_SEC=60              # 격리 유지(§3 E5: 60s 후 connect)
RTO_TARGET_SEC=30
POST_OBSERVE_SEC=90
REJOIN_OBSERVE_SEC=60         # 복귀 후 팔로워 재합류 관찰 상한
