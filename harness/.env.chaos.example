# 격리 카오스 토폴로지 변수 예시. 복사해서 쓴다.
#   cp .env.chaos.example .env.chaos   (또는 PowerShell: Copy-Item .env.chaos.example .env.chaos)
# .env.chaos는 .gitignore로 추적 안 됨. 이 example만 커밋한다.
# 소비처: scripts/up.ps1(이미지 태그), scripts/lib.ps1(리스 TTL·env-file), docker-compose.chaos.yml.
# 데모 스택(PG 5432·Spring 8080·web 3000)과 포트·DB·컨테이너명이 전부 겹치지 않는다.
# 값 변경 시 scripts/lib.ps1 포트 상수도 함께 본다.

# 앱 이미지 태그. up.ps1이 bootJar를 이 태그로 빌드하고 compose가 참조한다.
CHAOS_APP_IMAGE=exchange-chaos-app:local

# PostgreSQL(격리). compose가 이 값으로 chaos-pg를 초기화한다.
CHAOS_PG_DB=exchange
CHAOS_PG_USER=exchange
CHAOS_PG_PASSWORD=exchange

# 전 노드 공유 마스터키. 봇이 발급한 키를 api 노드가 검증하려면 동일해야 한다.
# 형식: 32바이트 base64. 아래는 32바이트 zero의 base64(더미). 데모 전용, 운영 금지.
# 빈 값이면 StartupSecretValidator가 기동을 막으므로 반드시 채운다.
CHAOS_MASTER_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# 리스 파라미터. 형식: <정수>s. 데모 가속값 TTL 6s·tick 2s(tick<ttl 유지). 기본은 10s/3s.
# 부재 시 lib.ps1 Get-LeaseTtlSec는 10s로 폴백한다.
CHAOS_LEASE_TTL=6s
CHAOS_LEASE_TICK=2s

# 봇 목표 OPS. compose가 bots 컨테이너에 주입(${CHAOS_BOTS_OPS:-10}). 부재 시 10.
# 10인 근거는 2026-08-29 캘리브레이션 확정치다(harness.calibration_runs id=1). 노드의 주문
# 커맨드 수용 천장이 약 40~42/s이고, 봇 10 OPS가 주문 9.4/s에 취소와 8개 마켓 호가 갱신을
# 더하므로 봇 40 OPS는 봇만으로 천장에 닿는다(검증설계 §2-4, 실측이 아니라 산술 유도).
# 그 대역에서는 외부 주입이 대부분 429가 된다.
# 이 값은 봇 거버너 축이고 카오스 실험은 config/*.env의 BASE_OPS를 lib.ps1 Set-BotOps로
# 명시 적용하므로, 이 기본값을 바꿔도 E1~E9 판정 조건은 달라지지 않는다.
CHAOS_BOTS_OPS=10

# WebSocket 중계 오버레이(harness/docker-compose.relay.yml, ADR 0034 S6)의 브로커 비밀 값. 브로커는 RABBITMQ_DEFAULT_PASS 로,
# 두 앱 노드는 EXCHANGE_WS_RELAY_BROKER_PASSCODE 로 받는다. 값은 .env.chaos 에만 적고 이 예시에는 적지 않는다(하네스 CI/CD §7-1).
# 비어 있으면 오버레이를 겹친 compose 가 해석 단계에서 멈춘다. 기본 스택(오버레이 없음)은 이 키를 쓰지 않는다.
CHAOS_RELAY_PASSCODE=

# 회원 세션 서명 시드와 비밀번호 페퍼(각 32바이트 base64). 두 앱 노드가 EXCHANGE_MEMBER_SESSION_SEED_BASE64,
# EXCHANGE_MEMBER_PASSWORD_PEPPER_BASE64 로 같은 값을 받는다. 비우면 노드마다 프로세스 한정 임의 키라 api-1 이 낸 회원 토큰을
# api-2 가 401 로 거절한다. 두 노드에 회원 요청을 나눠 보내는 실험(ADR 0034 S7 Q1)은 값을 채운다. 값은 .env.chaos 에만 적는다.
#   PowerShell: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
CHAOS_MEMBER_SESSION_SEED_BASE64=
CHAOS_MEMBER_PASSWORD_PEPPER_BASE64=

# 주행 식별자(RUN_ID). 이 파일에 고정하지 않는다. 값이 겹치면 order_flow.js의
# client_order_id가 이전 주행과 재사용돼 서버가 멱등 재생(200)으로 처리하고, 그 요청은
# 엔진에 닿지 않는다(실측 2026-08-29: 30 OPS 주행 3,600건 중 2,799건이 재생).
# 부하 주입 명령 직전에 셸이 준다. compose가 그 값을 chaos-k6 환경으로 넘긴다.
#   $env:RUN_ID = (Get-Date).ToString('yyyyMMdd-HHmmss')
#   docker compose --env-file harness/.env.chaos --profile load run --rm chaos-k6
# 미설정이면 빈 값이 들어가고 order_flow.js가 즉시 중단한다. 조용한 상수 폴백은 없다.
# RUN_ID=
