# E6 표준 프로파일(폭주 + 리더 kill 복합, 검증설계 §2-2·§3 E6). 재현용.
# order_flow.js는 -e KEY=VALUE로 이 값을 받는다. 오케스트레이터가 카오스 주입과 동일
# 타임라인(CHAOS_T0_S)을 공유한다.
PROFILE=e6
BASE_URL=http://localhost:58080     # chaos-lb(nginx). 데모 스택과 무충돌 포트
WS_URL=ws://localhost:58080/ws/v1
API_HOST=api.exchange.local
MARKET=KRW-BTC
# 외부 k6 주입 축(§2-4 확정, harness.calibration_runs id=1). 봇 거버너 축(config/e6.env의
# BASE_OPS·SPIKE_OPS)과 다른 축이므로 값을 서로 옮기지 않는다.
STEADY_RATE=10                      # 기저. 봇 10 OPS 병행에서 429 0·주문 p95 29.1ms
READ_RATE=17                        # 조회. 기저 x 1.667(정본 300:500 비 유지)
SPIKE_RATE=100                      # 기저의 10배. 종전 3,000은 미측정 명목치였다
WS_VUS=300
# spikeStart 10m + 램프 30s = plateau 진입 630s, +30s(RTO 30s 배 마진)에 kill → 660s.
# T1 = T0 + 60s(RTO 2배 마진). 이 창 표본만 phase:chaos. 둘은 반드시 함께 준다.
CHAOS_T0_S=660
CHAOS_T1_S=720
# 창 실패 예산(검증설계 §2-2). E6은 리더 kill이라 창에 다운타임이 정본상 허용된다.
# 상한은 유도값 RTO_TARGET_S/창 길이 = 30/60 = 0.5. 표식이 없으면 창에도 0.001이 걸린다.
FAILOVER_WINDOW=1
RTO_TARGET_S=30                     # harness/config/e6.env RTO_TARGET_SEC와 같은 값을 준다
K6_KEYS=./secrets/k6_keys.json      # seed 잡 산출물(access_key→secret). gitignore 대상
# RUN_ID는 이 파일에 고정하지 않는다. 주행마다 유일해야 한다. 고정하면 client_order_id가
# 이전 주행과 겹쳐 서버가 멱등 재생(200)으로 처리하고, 그 요청은 엔진에 닿지 않는다
# (실측 2026-08-29: 30 OPS 주행 3,600건 중 2,799건이 재생). 주행 명령에서 준다.
#   k6 run --env RUN_ID=$((Get-Date).ToString('yyyyMMdd-HHmmss')) ... order_flow.js
# 컨테이너 경로는 compose가 chaos-k6 환경으로 넘긴다(compose.yaml 머리 주석).
# RUN_ID=
