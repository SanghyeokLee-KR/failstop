# E6 표준 프로파일(폭주 + 리더 kill 복합, 검증설계 §2-2·§3 E6). 재현용.
# order_flow.js는 -e KEY=VALUE로 이 값을 받는다. 오케스트레이터가 카오스 주입과 동일
# 타임라인(CHAOS_T0_S)을 공유한다.
PROFILE=e6
BASE_URL=http://localhost:58080     # chaos-lb(nginx). 데모 스택과 무충돌 포트
WS_URL=ws://localhost:58080/ws/v1
API_HOST=api.exchange.local
MARKET=KRW-BTC
SPIKE_RATE=3000                     # 캘리브레이션 상한. §2-4 미충족 시 하향치로 치환
WS_VUS=300
# spikeStart 10m + 램프 30s = plateau 진입 630s, +30s(RTO 30s 배 마진)에 kill → 660s.
# T1 = T0 + 60s(RTO 2배 마진). 이 창 표본만 phase:chaos. 둘은 반드시 함께 준다.
CHAOS_T0_S=660
CHAOS_T1_S=720
# 창 실패 예산(검증설계 §2-2). E6은 리더 kill이라 창에 다운타임이 정본상 허용된다.
# 상한은 유도값 RTO_TARGET_S/창 길이 = 30/60 = 0.5. 표식이 없으면 창에도 0.001이 걸린다.
FAILOVER_WINDOW=1
RTO_TARGET_S=30                     # harness/config/e6.env RTO_TARGET_SEC와 같은 값을 준다
K6_KEYS=./secrets/k6_keys.json      # seed 잡 산출물(access_key→secret). gitignore 대상
