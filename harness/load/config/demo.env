# 데모 프로파일(발표 15분 스크립트, 검증설계 §7). 재현용.
# kill(05:30 = 330s)이 스파이크 plateau(02:30~06:30) 안에 위치해 E6 중첩이 성립한다.
PROFILE=demo
BASE_URL=http://localhost:58080
WS_URL=ws://localhost:58080/ws/v1
API_HOST=api.exchange.local
MARKET=KRW-BTC
SPIKE_RATE=3000
WS_VUS=300
CHAOS_T0_S=330                      # 05:30 kill(§7 데모 표와 1:1). T1과 함께 준다
CHAOS_T1_S=390
# 창 실패 예산(검증설계 §2-2). 데모는 리더 kill을 포함하므로 페일오버 창이다.
# 상한은 유도값 RTO_TARGET_S/창 길이 = 30/60 = 0.5.
FAILOVER_WINDOW=1
RTO_TARGET_S=30
K6_KEYS=./secrets/k6_keys.json
