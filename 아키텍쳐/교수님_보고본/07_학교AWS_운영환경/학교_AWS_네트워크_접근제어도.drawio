        <mxCell id="b49" value="" style="rounded=1;arcSize=6;html=1;fillColor=#F7F9FA;strokeColor=#E3E7EA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="56" y="1000" width="2444" height="310" as="geometry"/></mxCell>
        <mxCell id="q50" value="&lt;b&gt;A&lt;/b&gt;" style="ellipse;html=1;fillColor=#1A73E8;strokeColor=#FFFFFF;strokeWidth=2;fontFamily=Segoe UI;fontSize=20;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="95" y="1045" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="x51" value="&lt;b&gt;공개된 문은 80·443 뿐이다&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=21;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="148" y="1042" width="600" height="42" as="geometry"/></mxCell>
        <mxCell id="x52" value="app-1 만 0.0.0.0/0 이다. 80 은 인증서와 이동 전용이다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=17;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="148" y="1082" width="660" height="56" as="geometry"/></mxCell>
        <mxCell id="q53" value="&lt;b&gt;B&lt;/b&gt;" style="ellipse;html=1;fillColor=#C925D1;strokeColor=#FFFFFF;strokeWidth=2;fontFamily=Segoe UI;fontSize=20;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="853" y="1045" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="x54" value="&lt;b&gt;443 한 줄에 다 매달려 있다&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=21;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="906" y="1042" width="600" height="42" as="geometry"/></mxCell>
        <mxCell id="x55" value="관제 화면·봇 관리자도 이 경로다. 각자 인증으로만 막는다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=17;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="906" y="1082" width="700" height="56" as="geometry"/></mxCell>
        <mxCell id="q56" value="&lt;b&gt;C&lt;/b&gt;" style="ellipse;html=1;fillColor=#0F9D58;strokeColor=#FFFFFF;strokeWidth=2;fontFamily=Segoe UI;fontSize=20;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1623" y="1045" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="x57" value="&lt;b&gt;SSH 는 규칙과 경로가 다르다&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=21;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1676" y="1042" width="600" height="42" as="geometry"/></mxCell>
        <mxCell id="x58" value="22 는 EC2 Instance Connect 접두사만 열고, 접속은 SSM 으로 했다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=17;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="1676" y="1082" width="760" height="56" as="geometry"/></mxCell>
        <mxCell id="x59" value="&lt;b&gt;확인한 것&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=19;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="112" y="1172" width="300" height="34" as="geometry"/></mxCell>
        <mxCell id="x60" value="80·443 공개 · 그 밖의 인바운드는 SG 또는 접두사 목록 출발지 · 403 차단 응답 · SSM 으로 4대 접속" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=17;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="112" y="1206" width="1200" height="50" as="geometry"/></mxCell>
        <mxCell id="x61" value="&lt;b&gt;아직 확인하지 못한 것&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=19;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1340" y="1172" width="400" height="34" as="geometry"/></mxCell>
        <mxCell id="x62" value="아웃바운드 규칙 · app-1 외 노드의 공인 IPv4 · 사용자 PC /32 규칙 잔존 여부" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=17;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="1340" y="1206" width="1200" height="50" as="geometry"/></mxCell>
        <mxCell id="f63" value="차단은 보안 그룹과 app-1 Nginx 설정으로만 한다. 호스트 방화벽·SELinux 정책은 작성하지 않았다. 보안 그룹 ID·규칙 ID와 포트 전체 목록은 근거 문서에 있다. 근거: docs/reports/AWS_작업.md · deploy/linux/app/nginx-https.conf · docs/reference/adr/0099-current-architecture.md" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=16;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="56" y="1350" width="2448" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
