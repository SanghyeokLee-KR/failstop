        <mxCell id="q40" value="&lt;b&gt;A&lt;/b&gt;" style="ellipse;html=1;fillColor=#1A73E8;strokeColor=#FFFFFF;strokeWidth=2;fontFamily=Segoe UI;fontSize=20;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="95" y="1045" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="x41" value="&lt;b&gt;무중단이 아니다&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=21;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="148" y="1042" width="640" height="42" as="geometry"/></mxCell>
        <mxCell id="x42" value="앱 중단 3분 52초. 격리 뒤 거래 증가 재확인까지 2분 52초.&lt;br/&gt;사람 확인 간격이 포함된 관측값이고 측정된 RTO가 아니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=17;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="148" y="1082" width="660" height="76" as="geometry"/></mxCell>
        <mxCell id="q43" value="&lt;b&gt;B&lt;/b&gt;" style="ellipse;html=1;fillColor=#C925D1;strokeColor=#FFFFFF;strokeWidth=2;fontFamily=Segoe UI;fontSize=20;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="853" y="1045" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="x44" value="&lt;b&gt;승격은 사람이 실행한다&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=21;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="906" y="1042" width="640" height="42" as="geometry"/></mxCell>
        <mxCell id="x45" value="자동 페일오버 장치가 없다.&lt;br/&gt;격리를 눈으로 확인한 뒤 사람이 승격 명령을 실행한다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=17;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="906" y="1082" width="680" height="76" as="geometry"/></mxCell>
        <mxCell id="q46" value="&lt;b&gt;C&lt;/b&gt;" style="ellipse;html=1;fillColor=#0F9D58;strokeColor=#FFFFFF;strokeWidth=2;fontFamily=Segoe UI;fontSize=20;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1623" y="1045" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="x47" value="&lt;b&gt;백업이 서버 안에만 있다&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=21;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1676" y="1042" width="700" height="42" as="geometry"/></mxCell>
        <mxCell id="x48" value="격리 복원 검증은 통과했다.&lt;br/&gt;백업본과 보존한 옛 데이터가 같은 서버에 있다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=17;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="1676" y="1082" width="760" height="76" as="geometry"/></mxCell>
