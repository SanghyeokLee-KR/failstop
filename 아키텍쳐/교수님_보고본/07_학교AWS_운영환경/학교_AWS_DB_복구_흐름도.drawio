        <mxCell id="bt35" value="&lt;b&gt;&lt;font style=&quot;font-size:20px;color:#D93025&quot;&gt;앱 중단 3분 52초&lt;/font&gt;&lt;/b&gt;&amp;#160;&amp;#160;&lt;font style=&quot;font-size:17px;color:#5F6368&quot;&gt;01:53:48 앱 중지 → 01:57:40 거래 증가 재확인&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=17;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="112" y="894" width="1240" height="46" as="geometry"/></mxCell>
