        <mxCell id="x49" value="&lt;b&gt;감지·판정·보고가 한 대에 있다&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=21;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="148" y="1042" width="600" height="42" as="geometry"/></mxCell>
        <mxCell id="x50" value="수집·규칙·경보·보고가 모두 bot-1이다. 이 노드가 멈추면 감지도 멈춘다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=17;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="148" y="1082" width="680" height="56" as="geometry"/></mxCell>
        <mxCell id="q51" value="&lt;b&gt;B&lt;/b&gt;" style="ellipse;html=1;fillColor=#C925D1;strokeColor=#FFFFFF;strokeWidth=2;fontFamily=Segoe UI;fontSize=20;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="853" y="1045" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="x52" value="&lt;b&gt;AI는 설명만 쓴다&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=21;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="906" y="1042" width="600" height="42" as="geometry"/></mxCell>
        <mxCell id="x53" value="요약 문장만 만든다. 서버·DB·대수 조치는 사람이 한다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=17;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="906" y="1082" width="680" height="56" as="geometry"/></mxCell>
