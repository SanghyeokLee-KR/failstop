        <mxCell id="x41" value="exchange 등 6개가 로그인 불가 셸이다. 앱 계정은 설정 경로에 쓰지 못한다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=17;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="148" y="1082" width="700" height="56" as="geometry"/></mxCell>
        <mxCell id="q42" value="&lt;b&gt;B&lt;/b&gt;" style="ellipse;html=1;fillColor=#C925D1;strokeColor=#FFFFFF;strokeWidth=2;fontFamily=Segoe UI;fontSize=20;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="853" y="1045" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="x43" value="&lt;b&gt;용량 보호기가 봇만 멈춘다&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=21;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="906" y="1042" width="600" height="42" as="geometry"/></mxCell>
        <mxCell id="x44" value="네 노드 중 하나라도 여유가 모자라면 봇을 중지한다. 데이터는 지우지 않는다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=17;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="906" y="1082" width="700" height="56" as="geometry"/></mxCell>
        <mxCell id="q45" value="&lt;b&gt;C&lt;/b&gt;" style="ellipse;html=1;fillColor=#0F9D58;strokeColor=#FFFFFF;strokeWidth=2;fontFamily=Segoe UI;fontSize=20;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1623" y="1045" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="x46" value="&lt;b&gt;메모리 상한으로 OOM을 막는다&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=21;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1676" y="1042" width="600" height="42" as="geometry"/></mxCell>
        <mxCell id="x47" value="앱 · 봇 유닛에 MemoryMax를 두고 JVM 힙을 그 아래로 잡았다. 봇 OOM은 0건이다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=17;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="1676" y="1082" width="760" height="56" as="geometry"/></mxCell>
        <mxCell id="x48" value="&lt;b&gt;확인한 것&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=19;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="112" y="1172" width="300" height="34" as="geometry"/></mxCell>
        <mxCell id="x49" value="네 대 유닛 기동 · 앱 계정 쓰기 거부 · 봇 OOM 0건 · 지표 끊김 판정으로 봇 자동 중지 1회" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=17;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="112" y="1206" width="1180" height="50" as="geometry"/></mxCell>
        <mxCell id="x50" value="&lt;b&gt;아직 확인하지 못한 것&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=19;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1340" y="1172" width="400" height="34" as="geometry"/></mxCell>
        <mxCell id="x51" value="bot-1 재부팅 뒤 로그 보존 · 장시간 운영 중 상한 도달 · 디스크를 실제로 채운 중지 시험" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=17;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="1340" y="1206" width="1140" height="50" as="geometry"/></mxCell>
        <mxCell id="f52" value="유닛 파일 경로·환경 파일·퍼미션 값은 문서에 있다. 근거: docs/reports/AWS_작업.md · deploy/linux/ · docs/reference/adr/0099-current-architecture.md" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=16;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="56" y="1350" width="2448" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
